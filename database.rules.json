{
  "rules": {
    "scores": {
      ".read": true,
      "$uuid": {
        ".write": "auth != null && !newData.exists()",
        ".validate": "newData.hasChildren(['name', 'score'])",
        ".indexOn": ["score"],
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "score": {
          ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 5000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "scores_v2": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'score'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
        },
        "score": {
          ".validate": "newData.isNumber() && newData.val() % 5 === 0 && newData.val() >= -1000 && newData.val() <= 5000"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
